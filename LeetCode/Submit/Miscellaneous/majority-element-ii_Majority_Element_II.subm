class Solution {
    public List<Integer> majorityElement(int[] nums) {
        List<Integer> maj=new ArrayList<>();
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<n;i++)
        {
           
        }
           map.put(nums[i],map.getOrDefault(nums[i],0)+1);
        for( int x:map.keySet())
        int n=nums.length;
        {
            if(map.get(x)>n/3)
        }
    }
            maj.add(x);
        return maj;
}