 * Problem: 3Sum - Naukri Code 360
 * Problem Link: https://www.naukri.com/code360/problems/triplets-with-given-sum_893028
 * Language: All languages
 * Concept: Miscellaneous
 * Difficulty: Easy
 * Status: ACCEPTED
 */

import java.util.*;

public class Solution {

    public static ArrayList<ArrayList<Integer>> findTriplets(
            int[] arr, int n, int K) {

        ArrayList<ArrayList<Integer>> ans = new ArrayList<>();

        Arrays.sort(arr);

        for (int i = 0; i < n - 2; i++) {

            // Skip duplicate first element
            if (i > 0 && arr[i] == arr[i - 1]) {
                continue;
            }
            int l = i + 1;
            int r = n - 1;
           while (l < r) {
                int sum = arr[i] + arr[l] + arr[r];
                if (sum == K) {
                    ArrayList<Integer> triplet = new ArrayList<>();
                    triplet.add(arr[i]);
                    triplet.add(arr[l]);
                    triplet.add(arr[r]);
                    ans.add(triplet);
                    l++;
                    r--;
                    while (l < r && arr[l] == arr[l - 1]) {
                        l++;
                    }
                    while (l < r && arr[r] == arr[r + 1]) {
                        r--;
                    }

                } 
                else if (sum < K) {
                    l++;
                } 
                else {
                    r--;
                }
            }
        }

        return ans;
    }
}